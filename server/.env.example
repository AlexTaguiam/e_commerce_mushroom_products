# ─────────────────────────────────────────────────────────────
#  SERVER — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000

# URL of the deployed frontend (used for CORS and PayMongo redirect URLs)
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# ── Database (Prisma + PostgreSQL) ────────────────────────────
# For local Postgres:      postgresql://user:password@localhost:5432/dbname
# For Supabase/Neon/etc.:  get both URLs from your provider's dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/your_db
DIRECT_URL=postgresql://user:password@localhost:5432/your_db

# ── Firebase Admin SDK ────────────────────────────────────────
# Found in Firebase Console → Project Settings → Service Accounts
# → Generate new private key (downloads a JSON file)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Paste the private_key value from the JSON. Keep the -----BEGIN/END PRIVATE KEY----- lines.
# Replace literal newlines with \n so the whole value fits on one line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# ── Cloudinary ────────────────────────────────────────────────
# Found in Cloudinary Console → Dashboard → API Keys
# The SDK reads CLOUDINARY_URL automatically — use this single variable.
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ── PayMongo ──────────────────────────────────────────────────
# Found in PayMongo Dashboard → Developers → API Keys
PAYMONGO_SECRET_KEY=sk_live_your_secret_key

# Found in PayMongo Dashboard → Developers → Webhooks
# This is the signing secret for verifying incoming webhook payloads.
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Resend (Transactional Email) ──────────────────────────────
# Found in Resend Dashboard → API Keys
RESEND_API_KEY=re_your_resend_api_key

# The email address that receives contact-form submissions
CONTACT_EMAIL_TO=your@email.com
